# ─── Public (inlined into the site at build time) ────────────────────────────
# 24/7 transfer desk, E.164 format. Until set, the site shows "+91 XXXXX XXXXX".
NEXT_PUBLIC_DESK_PHONE=
# Optional separate physician line (falls back to the desk number)
NEXT_PUBLIC_DOCTOR_DESK_PHONE=
# WhatsApp number with country code, digits only, e.g. 919876543210
NEXT_PUBLIC_WHATSAPP_NUMBER=
NEXT_PUBLIC_CONTACT_EMAIL=
# Canonical site URL (defaults to the Vercel production URL)
NEXT_PUBLIC_SITE_URL=
# Set to "true" ONLY when every contact detail is verified: removes the preview
# ribbon and allows search engines to index the site.
NEXT_PUBLIC_LAUNCH_READY=false

# ─── Server only ─────────────────────────────────────────────────────────────
# Case storage (Supabase Postgres). Run supabase/migrations/0001_cases.sql first.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# New-case alerts (configure at least one before launch)
RESEND_API_KEY=
LEAD_NOTIFY_EMAIL=            # comma-separated
LEAD_FROM_EMAIL=              # e.g. "MedBridge Desk <desk@yourdomain.in>"
LEAD_WEBHOOK_URL=             # Slack incoming webhook / Zapier / Make / n8n

# Command Centre (/admin)
ADMIN_PASSWORD=
ADMIN_SECRET=                 # optional; random string used to sign sessions
